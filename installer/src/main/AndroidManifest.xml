<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <queries>
        <package android:name="br.com.pythoteca.experimental.reader"/>
        <package android:name="br.com.pythoteca.experimental.executor"/>
    </queries>
    <application android:label="Pythoteca Suite Experimental" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <receiver android:name=".InstallResult" android:exported="false"/>
    </application>
</manifest>
